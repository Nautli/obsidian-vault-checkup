{
  "name": "vault-checkup",
  "version": "1.0.0",
  "description": "A local, deterministic health check for Obsidian vaults.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": ["obsidian", "plugin", "vault", "health"],
  "author": "Vault Checkup Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
